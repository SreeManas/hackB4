# Copy to .env.local and adjust. All VITE_* values are public (bundled into the client).

# Base URL of the backend REST API (no trailing slash needed), e.g.
#   local development:  http://localhost:4000/api
#   production:         https://<your-api-host>/api
# Leave empty to run the frontend on built-in mock data.
VITE_API_BASE_URL=

# Force mock data even when VITE_API_BASE_URL is set ("true" / "false").
# Exception: every endpoint is now integrated with the backend and uses it whenever
# VITE_API_BASE_URL is set, regardless of this flag; see `liveEndpoints` in src/lib/api/index.ts.
VITE_USE_MOCKS=true

# Public site origin, used for canonical URLs, Open Graph and structured data.
VITE_SITE_URL=https://hackb4.com

# Browser push notifications ("Stay Updated" opt-in). NOT wired up yet - the frontend currently
# sends a placeholder per-browser token, not a real push subscription (see server/README.md).
# Only needed once a provider is chosen (handover/08, open question 5: FCM or OneSignal?) and, if
# the team goes with standards-based Web Push, a VAPID keypair is generated. Public key only -
# safe to expose client-side; the matching private key lives server-side only (server/.env.example).
VITE_VAPID_PUBLIC_KEY=
