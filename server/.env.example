NODE_ENV=
PORT=
CORS_ORIGINS=

# Runtime database connection (Supabase). For this long-running server prefer the SESSION pooler
# (port 5432, no `pgbouncer=true`, add `connection_limit=5`): measured ~5x faster per query than the
# transaction pooler (port 6543 + `pgbouncer=true`), because Prisma's pgbouncer mode costs about five
# round trips per query instead of one. Keep the transaction pooler for serverless hosts.
# `connect_timeout` (seconds): if unset the app adds `connect_timeout=10`; an explicit value wins.
# Latency scales with distance: host the API in the same region as the database.
DATABASE_URL=
# Direct connection used by Prisma migrations.
DIRECT_URL=

# Internal email alerts sent when POST /contact or POST /service-inquiries succeeds.
# Generic SMTP via Nodemailer; HACKB4 uses Resend:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=resend
#   SMTP_PASS=<your Resend API key - keep it in the real .env / host secrets only, never commit it>
# Leave all of these unset to disable alerts entirely: submissions are still stored normally, and
# the server logs one startup warning per disabled kind instead of failing. A send failure is logged
# as "[notify] failed to send ..." and never affects the API response.
SMTP_HOST=
# Defaults to 587 (STARTTLS) if unset. Resend uses 465 with SMTP_SECURE=true (implicit TLS).
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# "From" address on outgoing alert emails. Resend only sends from a domain you have verified in the
# Resend dashboard (e.g. alerts@hackb4.com). For a first test you can use onboarding@resend.dev, but
# Resend then delivers only to the email address of your own Resend account.
NOTIFY_FROM_EMAIL=
# Where each kind of alert is sent. Both must be set for that kind's alerts to go out.
NOTIFY_CONTACT_TO_EMAIL=
NOTIFY_INQUIRY_TO_EMAIL=

# Browser push notifications ("Stay Updated" opt-in on /events), standards-based Web Push with VAPID -
# no Firebase/OneSignal account. Generate the keypair once: `npx web-push generate-vapid-keys`.
# POST /notifications/subscribe stores subscriptions whether or not these are set; sending needs all
# three. If any is missing or malformed the API still runs (it logs a startup warning) and
# `npm run push:send` refuses with a message naming the problem.
# Send a broadcast with: npm run push:send -- --title "..." --body "..." --url /events  (add --dry-run to count only)
# Private key: server-side only, never sent to the frontend.
VAPID_PRIVATE_KEY=
# Must match VITE_VAPID_PUBLIC_KEY in the frontend's .env (root .env.example).
VAPID_PUBLIC_KEY=
# Contact URI required by the VAPID spec, e.g. mailto:ops@hackb4.com
VAPID_SUBJECT=
