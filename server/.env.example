NODE_ENV=
PORT=
CORS_ORIGINS=

# Runtime database connection (Supabase). For this long-running server prefer the SESSION pooler
# (port 5432, no `pgbouncer=true`, add `connection_limit=5`): measured ~5x faster per query than the
# transaction pooler (port 6543 + `pgbouncer=true`), because Prisma's pgbouncer mode costs about five
# round trips per query instead of one. Keep the transaction pooler for serverless hosts.
# `connect_timeout` (seconds): if unset the app adds `connect_timeout=10`; an explicit value wins.
# Latency scales with distance: host the API in the same region as the database.
DATABASE_URL=
# Direct connection used by Prisma migrations.
DIRECT_URL=

# Internal email alerts sent when POST /contact or POST /service-inquiries succeeds.
# Generic SMTP - works with any provider (Amazon SES, Resend, SendGrid, Postmark, ...) without a
# code change, since no provider has been chosen yet (see handover/08, open question 6).
# Leave all of these unset to disable alerts entirely: submissions are still stored normally, and
# the server logs one startup warning per disabled kind instead of failing.
SMTP_HOST=
# Defaults to 587 (STARTTLS) if unset. Use 465 with SMTP_SECURE=true for implicit TLS.
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# "From" address on outgoing alert emails (often must be a domain verified with the SMTP provider).
NOTIFY_FROM_EMAIL=
# Where each kind of alert is sent. Both must be set for that kind's alerts to go out.
NOTIFY_CONTACT_TO_EMAIL=
NOTIFY_INQUIRY_TO_EMAIL=

# Browser push notifications ("Stay Updated" opt-in on /events). NOT wired up yet: POST
# /notifications/subscribe already stores tokens (idempotent), but the frontend currently sends a
# placeholder per-browser token, not a real one - see server/README.md.
# No provider has been chosen (handover/08, open question 5: FCM or OneSignal? who owns the
# account?), so this only names the config a standards-based Web Push implementation would need: a
# self-generated VAPID keypair (e.g. via `npx web-push generate-vapid-keys`), no third-party account
# required. A hosted provider (FCM/OneSignal) would need different, provider-specific variables
# instead - do not add those speculatively before that decision is made.
# Private key: server-side only, never sent to the frontend.
VAPID_PRIVATE_KEY=
# Must match VITE_VAPID_PUBLIC_KEY in the frontend's .env (root .env.example).
VAPID_PUBLIC_KEY=
# Contact URI required by the VAPID spec, e.g. mailto:ops@hackb4.com
VAPID_SUBJECT=
