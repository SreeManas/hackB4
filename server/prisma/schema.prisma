// HACKB4 database schema (PostgreSQL).
//
// Conventions
// - Prisma fields are camelCase; every table/column is mapped to snake_case.
// - Primary keys are UUIDs generated by the database (gen_random_uuid()).
// - Timestamps are timestamptz with explicit defaults. @updatedAt is NOT used:
//   the application sets updated_at explicitly on writes.
// - The API contract (snake_case JSON, bare arrays, no server-only fields) is
//   produced by a serializer layer, not by this schema.
//
// PostgreSQL CHECK constraints
// Prisma cannot express CHECK constraints. They are documented next to each
// model as "CHECK:" and must be added by hand to the first migration's SQL.
//
// Deliberately absent: users, platform_stats, auth tables and
// notification-provider tables (deferred / undecided).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Events shown on /events, /events/:slug and the home page.
///
/// CHECK: events_category_check   CHECK (category IN ('hackathon', 'placement', 'workshop'))
/// CHECK: events_event_type_check CHECK (event_type IN ('virtual', 'in_person', 'hybrid', 'pan_india'))
/// CHECK: events_dates_check      CHECK (end_date >= start_date)
/// Server-only (never in the API): is_published, created_at, updated_at.
/// Event status (active/upcoming/completed) is derived by the frontend from the dates.
model Event {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                    String   @db.VarChar(255)
  slug                     String   @unique @db.VarChar(255)
  shortSummary             String   @map("short_summary")
  detailedDescription      String   @map("detailed_description")
  bannerImageUrl           String   @map("banner_image_url")
  devnovateRegistrationUrl String   @map("devnovate_registration_url")
  /// hackathon | placement | workshop
  category                 String   @db.VarChar(20)
  /// virtual | in_person | hybrid | pan_india
  eventType                String   @default("pan_india") @map("event_type") @db.VarChar(20)
  location                 String   @db.VarChar(150)
  startDate                DateTime @map("start_date") @db.Timestamptz(6)
  /// Required (the PDF allowed NULL; the frontend does not).
  endDate                  DateTime @map("end_date") @db.Timestamptz(6)
  isFeatured               Boolean  @default(false) @map("is_featured")
  isPublished              Boolean  @default(true) @map("is_published")

  // Optional listing fields (cards hide whatever is missing).
  tags              String[] @default([])
  durationHours     Int?     @map("duration_hours")
  teamSizeMin       Int?     @map("team_size_min")
  teamSizeMax       Int?     @map("team_size_max")
  participantsCount Int?     @map("participants_count")
  /// Whole rupees.
  prizePoolInr      Int?     @map("prize_pool_inr")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  conversions  EventConversion[]
  projects     Project[]
  teamOpenings TeamOpening[]

  // NOTE: the intended index is partial (WHERE is_published); add it by hand in the migration if wanted.
  @@index([category, isPublished])
  @@map("events")
}

/// One row per REGISTER NOW click. Write-only; never exposed.
model EventConversion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  source    String   @db.VarChar(50)
  medium    String   @db.VarChar(50)
  campaign  String?  @db.VarChar(100)
  userAgent String?  @map("user_agent")
  referrer  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_conversions")
}

/// The service cards on /services. `title` is also what inquiries send as service_type.
/// Server-only: sort_order.
model Service {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String @unique @db.VarChar(100)
  description String
  /// One of the frontend's ServiceIconName values.
  icon        String @db.VarChar(40)
  sortOrder   Int    @default(0) @map("sort_order")

  @@map("services")
}

/// Team members on /our-team. Server-only: sort_order.
model TeamMember {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String @db.VarChar(120)
  role      String @db.VarChar(80)
  /// Absolute URL or site-relative path.
  image     String
  sortOrder Int    @default(0) @map("sort_order")

  @@map("team_members")
}

/// Scroll-triggered popup ads.
///
/// CHECK: ad_campaigns_scroll_threshold_check CHECK (scroll_threshold_percent BETWEEN 0 AND 100)
/// Server-only: is_active, start_date, end_date, created_at, updated_at.
model AdCampaign {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                  String    @db.VarChar(150)
  imageUrl               String    @map("image_url")
  destinationUrl         String    @map("destination_url")
  targetPage             String    @default("/events") @map("target_page") @db.VarChar(100)
  scrollThresholdPercent Int       @default(50) @map("scroll_threshold_percent")
  isActive               Boolean   @default(true) @map("is_active")
  startDate              DateTime? @map("start_date") @db.Timestamptz(6)
  endDate                DateTime? @map("end_date") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("ad_campaigns")
}

/// Lead capture. Write-only. service_type stores the service TITLE as text (no FK).
/// status values: pending | contacted | closed (application-level, default pending).
model ServiceInquiry {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientName       String   @map("client_name") @db.VarChar(120)
  organizationName String   @map("organization_name") @db.VarChar(200)
  organizationType String?  @map("organization_type") @db.VarChar(50)
  email            String   @db.VarChar(255)
  phone            String?  @db.VarChar(20)
  serviceType      String   @map("service_type") @db.VarChar(100)
  budgetRange      String?  @map("budget_range") @db.VarChar(50)
  message          String?
  status           String   @default("pending") @db.VarChar(30)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("service_inquiries")
}

/// Contact form submissions. Write-only.
/// status values: application-level, default new.
model ContactMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(255)
  message   String
  status    String   @default("new") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("contact_messages")
}

/// Newsletter / early-access list. Write-only.
/// The application lower-cases emails before every read/write; the unique index is case-sensitive.
model NewsletterSubscriber {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(255)
  /// Every source seen for this email, e.g. {footer,early_access:teams}.
  sources      String[] @default([])
  isActive     Boolean  @default(true) @map("is_active")
  subscribedAt DateTime @default(now()) @map("subscribed_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("newsletter_subscribers")
}

/// Browser Web Push subscriptions (standards-based Web Push + VAPID). Written by the public API,
/// read only by the broadcast sender (src/services/notify/webPushSender.ts).
/// `endpoint` is the push service URL and uniquely identifies a browser subscription; p256dh/auth are
/// the keys the payload is encrypted with. Both are NULL only for legacy placeholder rows, which the
/// sender skips. user_id has no relation: there is no users table (authentication is deferred).
model PushSubscription {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  endpoint     String   @unique
  p256dh       String?
  auth         String?
  browser      String?  @db.VarChar(50)
  os           String?  @db.VarChar(50)
  isActive     Boolean  @default(true) @map("is_active")
  subscribedAt DateTime @default(now()) @map("subscribed_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("push_subscriptions")
}

/// Featured community projects on the home page.
/// API `hackathon_title` comes from the related event's title.
/// Server-only: is_featured, created_at, updated_at.
model Project {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Display number: 47 -> "PROJECT 047".
  number      Int      @unique
  slug        String   @unique @db.VarChar(255)
  title       String   @db.VarChar(200)
  tagline     String   @db.VarChar(255)
  description String?
  categories  String[] @default([])
  tech        String[] @default([])
  teamName    String   @map("team_name") @db.VarChar(120)
  eventId     String?  @map("event_id") @db.Uuid
  award       String?  @db.VarChar(50)
  isFeatured  Boolean  @default(false) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("projects")
}

/// Public builder profiles on the home page.
/// Server-only: is_featured (set only with the person's consent), created_at, updated_at.
model Builder {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @db.VarChar(120)
  handle          String   @unique @db.VarChar(50)
  role            String   @db.VarChar(80)
  stack           String[] @default([])
  hackathonsCount Int      @default(0) @map("hackathons_count")
  projectsCount   Int      @default(0) @map("projects_count")
  city            String?  @db.VarChar(80)
  openToTeam      Boolean  @default(false) @map("open_to_team")
  isFeatured      Boolean  @default(false) @map("is_featured")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("builders")
}

/// Teams looking for members. API `hackathon_title` comes from the related event's title.
///
/// CHECK: team_openings_members_check CHECK (members_count <= team_size)
/// Server-only: is_open, created_at, updated_at.
model TeamOpening {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamName     String   @map("team_name") @db.VarChar(120)
  eventId      String   @map("event_id") @db.Uuid
  roles        String[] @default([])
  membersCount Int      @map("members_count")
  teamSize     Int      @map("team_size")
  isOpen       Boolean  @default(true) @map("is_open")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("team_openings")
}

/// Community activity ticker (queried newest first).
///
/// CHECK: activity_type_check CHECK (type IN ('submission', 'team_formed', 'award', 'hackathon_launched'))
model Activity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// submission | team_formed | award | hackathon_launched
  type      String   @db.VarChar(30)
  actor     String   @db.VarChar(120)
  target    String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("activity")
}
